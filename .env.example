# Copy this file to .env (same folder) and fill in your keys.
GEMINI_API_KEY=
# Optional. New API keys can no longer use gemini-2.5-flash (the default).
GEMINI_MODEL=gemini-3.5-flash
YOUTUBE_API_KEY=
APIFY_API_TOKEN=

# Production storage (Vercel). Leave blank locally to use ../data/*.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the daily snapshot cron (F7)
CRON_SECRET=
