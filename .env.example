# Copy this file to .env (same folder) and fill in your keys.
GEMINI_API_KEY=
# Optional. New API keys can no longer use gemini-2.5-flash (the default).
GEMINI_MODEL=gemini-3.5-flash
# Optional. Tried when the main model is overloaded (503).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
YOUTUBE_API_KEY=
APIFY_API_TOKEN=

# Production storage (Vercel). Leave blank locally to use ../data/*.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects the daily snapshot cron (F7)
CRON_SECRET=

# Login for the whole app (required, or nobody can sign in).
# APP_PASSWORD: at least 12 characters. AUTH_SECRET: at least 32 random characters,
# e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing the username or password signs everyone out.
APP_USERNAME=
APP_PASSWORD=
AUTH_SECRET=
